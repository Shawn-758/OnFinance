# Copy to .env and adjust.
APP_NAME=Adams Onboarding Prototype
APP_ENV=dev

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=adams_onboarding

# Optional: use sqlite for local smoke tests without MySQL
# DATABASE_URL=sqlite:///./adams_onboarding.db

UPLOAD_DIR=./uploads

# Tesseract (Windows example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Laplacian variance below this is flagged as low-quality / likely blurry
BLUR_THRESHOLD=80.0
